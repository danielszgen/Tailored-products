# Variables de entorno de la función serverless api/rival.ts ("Pregunta al Rival", SPEC §10.2).
# Se configuran en Vercel (Settings → Environment Variables). Ninguna llega al cliente:
# Vite solo expone al navegador las variables con prefijo VITE_, y aquí no hay ninguna.

# Clave de la API de Anthropic. Solo la lee el servidor; nunca en el cliente.
ANTHROPIC_API_KEY=

# Token secreto de la app: el mismo que Daniel escribe en Ajustes → El Rival (queda en el
# localStorage de su iPhone). La función rechaza cualquier petición sin él. Nunca en el cliente.
RIVAL_APP_TOKEN=

# Modelo de Claude que responde (por defecto claude-opus-5).
RIVAL_MODEL=claude-opus-5

# Esfuerzo de razonamiento: low | medium | high (por defecto medium).
RIVAL_EFFORT=medium
